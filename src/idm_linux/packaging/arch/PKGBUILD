# Maintainer: BELGESELSEMO <vesvese55x@users.noreply.github.com>
# PKGBUILD — YENİ DEPO DÜZENİ: tüm uygulama ağacı src/idm_linux altındadır;
# bu dosya src/idm_linux/packaging/arch/ dizininde durur (CI ve makepkg burada çalıştırır).
pkgname=idm-linux
pkgver=1.0.0
pkgrel=1
pkgdesc="IDM LINUX (BELGESELSEMO) — Internet Download Manager'ı Linux'ta tam işlevsel kullanan entegrasyon katmanı"
arch=('any')
url="https://github.com/vesvese55x/IDM-LINUX"
license=('custom')
depends=('wine' 'python' 'tk')
optdepends=('yt-dlp: YouTube/video kaynak tespiti'
            'ffmpeg: birleştirme ve canlı kayıt'
            'aria2: hızlı çok parçalı indirme'
            'xdg-utils: masaüstü entegrasyonu')
options=('!strip' '!emptydirs')
source=()
md5sums=()

package() {
  # arch/ → packaging → idm_linux → src → depo kökü (4 üst dizin)
  local ROOT="$(cd "${startdir}/../../../.." && pwd)"
  local APP="${ROOT}/src/idm_linux"

  install -d "${pkgdir}/opt/${pkgname}"
  # Uygulama ağacı: src/idm_linux içeriği (packaging/tests/docs hariç) → /opt/idm-linux/src/idm_linux
  tar -cf - -C "${APP}" \
      --exclude=./__pycache__ \
      --exclude=./p2p/__pycache__ \
      --exclude='*.pyc' \
      --exclude=./tests \
      --exclude=./docs \
      --exclude=./packaging \
      . | tar -xf - -C "${pkgdir}/opt/${pkgname}/src/idm_linux"

  install -Dm0755 "${APP}/packaging/launcher.sh" "${pkgdir}/usr/bin/${pkgname}"
  # Büyük/küçük harf kolaylığı
  ln -sf "/usr/bin/${pkgname}" "${pkgdir}/usr/bin/IDM-LINUX"
  ln -sf "/usr/bin/${pkgname}" "${pkgdir}/usr/bin/IDM-Linux"
  install -Dm0644 "${APP}/packaging/idm-linux.desktop" "${pkgdir}/usr/share/applications/${pkgname}.desktop"
  install -Dm0644 "${ROOT}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"

  local _icon=""
  for c in "${APP}/assets/idm-linux-icon.png" "icons/idm-linux.png" "icons/icon.png" "icon.png" "idm-linux.png"; do
    if [ -f "${APP}/${c}" ]; then _icon="${APP}/${c}"; break; fi
  done
  if [ -z "${_icon}" ]; then
    python3 "${APP}/packaging/icon_gen.py" "${srcdir}/idm-linux.png"
    _icon="${srcdir}/idm-linux.png"
  fi
  install -Dm0644 "${_icon}" "${pkgdir}/usr/share/icons/hicolor/256x256/apps/${pkgname}.png"
}
