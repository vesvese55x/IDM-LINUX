>> "%SEMO_WORK%\setup_gui.cs" echo         System.Windows.Forms.Timer _anim;
>> "%SEMO_WORK%\setup_gui.cs" echo         public ModernBar()
>> "%SEMO_WORK%\setup_gui.cs" echo         {
