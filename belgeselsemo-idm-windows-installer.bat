>> "%SEMO_WORK%\setup_gui.cs" echo                 int d = _target - _val;
>> "%SEMO_WORK%\setup_gui.cs" echo                 _val += (d ^> 0) ? Math.Max(1, d / 5) : Math.Min(-1, d / 5);
>> "%SEMO_WORK%\setup_gui.cs" echo                 if (Math.Abs(_target - _val) ^< 1) _val = _target;
>> "%SEMO_WORK%\setup_gui.cs" echo                 this.Invalidate();
>> "%SEMO_WORK%\setup_gui.cs" echo             });
>> "%SEMO_WORK%\setup_gui.cs" echo         }
