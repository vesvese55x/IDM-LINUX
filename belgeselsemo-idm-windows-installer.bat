>> "%SEMO_WORK%\setup_gui.cs" echo                 {
>> "%SEMO_WORK%\setup_gui.cs" echo                     int[] arr = new int[i - start];
>> "%SEMO_WORK%\setup_gui.cs" echo                     for (int k = start; k ^< i; k++) arr[k - start] = k;
