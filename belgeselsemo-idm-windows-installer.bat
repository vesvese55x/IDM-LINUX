>> "%SEMO_WORK%\setup_gui.cs" echo                     Directory.Move(Path.Combine(INST, "ffmpeg"), keepFf);
>> "%SEMO_WORK%\setup_gui.cs" echo             }
>> "%SEMO_WORK%\setup_gui.cs" echo             catch { }
>> "%SEMO_WORK%\setup_gui.cs" echo             try
>> "%SEMO_WORK%\setup_gui.cs" echo             {
