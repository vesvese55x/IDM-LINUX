>> "%SEMO_WORK%\setup_gui.cs" echo             Log("[+] " + Tr2("setup.stage2ok", nf.ToString()) + ": " + INST, GREEN);
>> "%SEMO_WORK%\setup_gui.cs" echo             try
>> "%SEMO_WORK%\setup_gui.cs" echo             {
