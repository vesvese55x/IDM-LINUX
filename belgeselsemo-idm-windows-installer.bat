@echo off
setlocal EnableExtensions
title BELGESELSEMO IDM SEMO - Windows Setup
rem ---- v13: setup kaynaklari bat'tan dogrudan yaziliyor (decode ADIMI YOK; PS policy / cscript kilidi ortamdan ortama degisiyor) ----
if /i "%~1"=="__hidden__" goto :hidden
rem XP stock systems do not include PowerShell: use Windows Script Host.
> "%TEMP%\semo_relaunch.vbs" echo Dim sh, q, cmd
>> "%TEMP%\semo_relaunch.vbs" echo Set sh = CreateObject("WScript.Shell")
>> "%TEMP%\semo_relaunch.vbs" echo q = Chr(34)
>> "%TEMP%\semo_relaunch.vbs" echo cmd = sh.ExpandEnvironmentStrings(Chr(37) ^& "ComSpec" ^& Chr(37))
>> "%TEMP%\semo_relaunch.vbs" echo sh.Run q ^& cmd ^& q ^& " /d /c " ^& q ^& q ^& WScript.Arguments(0) ^& q ^& " __hidden__" ^& q, 0, False
wscript //nologo "%TEMP%\semo_relaunch.vbs" "%~sf0"
if not errorlevel 1 exit /b 0
rem WSH blocked/unavailable: continue visibly instead of silently exiting.

:hidden
chcp 65001 >nul
set "SEMO_WORK=%TEMP%\IDM_SEMO_setup"
set "SEMO_ERR=%TEMP%\IDM_SEMO_setup_err.log"
set "SEMO_FLAG=%TEMP%\semo_ready.flag"
if exist "%SEMO_FLAG%" del "%SEMO_FLAG%" >nul 2>&1
if exist "%SEMO_ERR%" del "%SEMO_ERR%" >nul 2>&1
>> "%SEMO_ERR%" echo [%DATE% %TIME%] kurulum basladi (gizli cmd)
call :write_wait
if exist "%SEMO_WORK%" rd /s /q "%SEMO_WORK%" >nul 2>&1
mkdir "%SEMO_WORK%" >nul 2>&1
if not exist "%SEMO_WORK%" (set "SEMO_MSG=Gecici kurulum klasoru yaratilamadi." & goto :fatal)
set "IS_ADMIN=0"
net session >nul 2>&1
if not errorlevel 1 set "IS_ADMIN=1"
if "%IS_ADMIN%"=="1" set "SEMO_INST=%ProgramFiles%\IDM-SEMO"
if "%IS_ADMIN%"=="0" set "SEMO_INST=%LOCALAPPDATA%\IDM-SEMO"
if "%SEMO_INST%"=="" set "SEMO_INST=C:\IDM-SEMO"
>> "%SEMO_ERR%" echo hedef: %SEMO_INST% (admin=%IS_ADMIN%)
set "CSC="
for /d %%D in ("%SystemRoot%\Microsoft.NET\Framework\v2.0.50727" "%SystemRoot%\Microsoft.NET\Framework\v3.*" "%SystemRoot%\Microsoft.NET\Framework\v4.*") do if exist "%%D\csc.exe" set "CSC=%%D\csc.exe"
if "%CSC%"=="" goto :nocsc
>> "%SEMO_ERR%" echo kurulum kaynaklari yaziliyor
call :write_setupsrc
set "SSZ=0"
for %%A in ("%SEMO_WORK%\setup_gui.cs") do set "SSZ=%%~zA"
if %SSZ% LSS 200000 (set "SEMO_MSG=Kurulum kaynaklari yazilamadi (dosya cok kucuk: %SSZ% bayt)." & goto :fatal)
>> "%SEMO_ERR%" echo kurulum kaynaklari yazildi: %SSZ% bayt
"%CSC%" /nologo /codepage:65001 /t:winexe /out:"%SEMO_WORK%\setup_gui.exe" /r:System.dll /r:System.Drawing.dll /r:System.Windows.Forms.dll "%SEMO_WORK%\setup_gui.cs" >"%SEMO_WORK%\setup_build.log" 2>&1
if errorlevel 1 goto :nobuild
if not exist "%SEMO_WORK%\setup_gui.exe" goto :noexe
>> "%SEMO_ERR%" echo setup gui derlendi, pencere aciliyor
echo ok> "%SEMO_FLAG%"
start "" "%SEMO_WORK%\setup_gui.exe" "%~f0" "%SEMO_INST%" "%IS_ADMIN%" "%CSC%"
exit /b 0

:nobuild
>> "%SEMO_ERR%" echo setup gui derlemesi basarisiz; csc ciktisi:
type "%SEMO_WORK%\setup_build.log" >> "%SEMO_ERR%" 2>nul
>> "%SEMO_ERR%" echo sessiz kurulum (fallback) basliyor
set "SEMO_MK=___SEMO"
call :write_dec
powershell -NoProfile -ExecutionPolicy Bypass -File "%SEMO_WORK%\semo_dec.ps1" "%~f0" "%SEMO_WORK%\payload.cab" "%SEMO_MK%_PAYLOAD___" >nul 2>&1
if not exist "%SEMO_WORK%\payload.cab" cscript //nologo "%SEMO_WORK%\semo_dec.vbs" "%~f0" "%SEMO_WORK%\payload.cab" "%SEMO_MK%_PAYLOAD___" >nul 2>&1
if not exist "%SEMO_WORK%\payload.cab" goto :errpay
:extract
if exist "%SEMO_INST%\ffmpeg" move "%SEMO_INST%\ffmpeg" "%SEMO_WORK%\keep_ffmpeg" >nul 2>&1
if exist "%SEMO_INST%" rd /s /q "%SEMO_INST%" >nul 2>&1
mkdir "%SEMO_INST%" >nul 2>&1
if not exist "%SEMO_INST%" (set "SEMO_MSG=Kurulum klasoru yaratilamadi: %SEMO_INST%" & goto :fatal)
expand "%SEMO_WORK%\payload.cab" -F:* "%SEMO_INST%" >nul
if errorlevel 1 (set "SEMO_MSG=Program dosyalari cikarilamadi." & goto :fatal)
if exist "%SEMO_WORK%\keep_ffmpeg" move "%SEMO_WORK%\keep_ffmpeg" "%SEMO_INST%\ffmpeg" >nul 2>&1
>> "%SEMO_ERR%" echo dosyalar cikarildi
call :make_shortcuts
echo ok> "%SEMO_FLAG%"
if "%CSC%"=="" goto :fb_start
pushd "%SEMO_INST%"
set "ICONOPT="
if exist "idm_icon.ico" set "ICONOPT=/win32icon:idm_icon.ico"
"%CSC%" /nologo /codepage:65001 /t:winexe /out:"%SEMO_INST%\IDM-SEMO.exe" %ICONOPT% /r:System.dll /r:System.Drawing.dll /r:System.Windows.Forms.dll "IDM_SEMO_*.cs" >"%SEMO_WORK%\build.log" 2>&1
if errorlevel 1 (
  echo panel derlemesi basarisiz>> "%SEMO_ERR%"
  type "%SEMO_WORK%\build.log" >> "%SEMO_ERR%" 2>nul
)
popd
:fb_start
if exist "%SEMO_INST%\IDM-SEMO.exe" start "" "%SEMO_INST%\IDM-SEMO.exe"
if exist "%SEMO_INST%\IDM-SEMO.exe" exit /b 0
set "SEMO_MSG=Kontrol paneli olusturulamadi."
goto :fatal

:nocsc
set "SEMO_MSG=csc.exe bulunamadi. XP: .NET 2.0 SP2, 3.5 SP1 veya 4.0 kurulmali. Yeni Windows: .NET 3.5 veya 4.x etkin olmali."
>> "%SEMO_ERR%" echo csc bulunamadi
goto :fatal
:noexe
set "SEMO_MSG=Kurulum sihirbazi acilamadi. Sihirbazi dosyasi antivurus tarafindan silinmis olabilir."
>> "%SEMO_ERR%" echo setup_gui.exe bulunamadi/engellendi
goto :fatal
:errpay
set "SEMO_MSG=Program dosyalari cikarilamadi. Antivurus yazilimi bat dosyasini engellemis olabilir."
>> "%SEMO_ERR%" echo payload decode/expand basarisiz
goto :fatal

:fatal
>> "%SEMO_ERR%" echo kurulum tamamlanamadi
echo ok> "%SEMO_FLAG%" 2>nul
if "%SEMO_MSG%"=="" set "SEMO_MSG=Kurulum baslatilamadi."
> "%TEMP%\semo_fatal.vbs" echo CreateObject("WScript.Shell").PopUp "%SEMO_MSG%" ^& vbCrLf ^& vbCrLf ^& "Ayrintili kurulum gunlugu:" ^& vbCrLf ^& "%SEMO_ERR%", 0, "BELGESELSEMO IDM SEMO", 16
wscript //nologo "%TEMP%\semo_fatal.vbs" >nul 2>&1
exit /b 1

:make_shortcuts
> "%SEMO_WORK%\semo_sc.vbs" echo Option Explicit
>> "%SEMO_WORK%\semo_sc.vbs" echo Dim ws, fso, lnk, lnk2, pm
>> "%SEMO_WORK%\semo_sc.vbs" echo Set ws = CreateObject("WScript.Shell")
>> "%SEMO_WORK%\semo_sc.vbs" echo Set fso = CreateObject("Scripting.FileSystemObject")
>> "%SEMO_WORK%\semo_sc.vbs" echo Set lnk = ws.CreateShortcut(ws.SpecialFolders("Desktop") ^& "\IDM SEMO.lnk")
>> "%SEMO_WORK%\semo_sc.vbs" echo lnk.TargetPath = "%SEMO_INST%\IDM-SEMO.exe"
>> "%SEMO_WORK%\semo_sc.vbs" echo lnk.WorkingDirectory = "%SEMO_INST%"
>> "%SEMO_WORK%\semo_sc.vbs" echo lnk.IconLocation = "%SEMO_INST%\IDM-SEMO.exe, 0"
>> "%SEMO_WORK%\semo_sc.vbs" echo lnk.Save
>> "%SEMO_WORK%\semo_sc.vbs" echo pm = ws.SpecialFolders("StartMenu") ^& "\Programs"
>> "%SEMO_WORK%\semo_sc.vbs" echo If Not fso.FolderExists(pm ^& "\IDM-SEMO") Then fso.CreateFolder(pm ^& "\IDM-SEMO")
>> "%SEMO_WORK%\semo_sc.vbs" echo Set lnk2 = ws.CreateShortcut(pm ^& "\IDM-SEMO\IDM SEMO.lnk")
>> "%SEMO_WORK%\semo_sc.vbs" echo lnk2.TargetPath = "%SEMO_INST%\IDM-SEMO.exe"
>> "%SEMO_WORK%\semo_sc.vbs" echo lnk2.WorkingDirectory = "%SEMO_INST%"
>> "%SEMO_WORK%\semo_sc.vbs" echo lnk2.IconLocation = "%SEMO_INST%\IDM-SEMO.exe, 0"
>> "%SEMO_WORK%\semo_sc.vbs" echo lnk2.Save
cscript //nologo "%SEMO_WORK%\semo_sc.vbs" >nul 2>&1
rem ---- taskbar pin: once kabuk fiili denenir, olmazsa pinned klasore kopya ----
> "%SEMO_WORK%\semo_pin.vbs" echo Option Explicit
>> "%SEMO_WORK%\semo_pin.vbs" echo On Error Resume Next
>> "%SEMO_WORK%\semo_pin.vbs" echo Dim ws, fso, sh, fld, itm, v, desk, ql, pinned
>> "%SEMO_WORK%\semo_pin.vbs" echo Set ws = CreateObject("WScript.Shell")
>> "%SEMO_WORK%\semo_pin.vbs" echo Set fso = CreateObject("Scripting.FileSystemObject")
>> "%SEMO_WORK%\semo_pin.vbs" echo desk = ws.SpecialFolders("Desktop") ^& "\IDM SEMO.lnk"
>> "%SEMO_WORK%\semo_pin.vbs" echo pinned = False
>> "%SEMO_WORK%\semo_pin.vbs" echo Set sh = CreateObject("Shell.Application")
>> "%SEMO_WORK%\semo_pin.vbs" echo Set fld = sh.Namespace(fso.GetParentFolderName(desk))
>> "%SEMO_WORK%\semo_pin.vbs" echo If Not fld Is Nothing Then
>> "%SEMO_WORK%\semo_pin.vbs" echo   Set itm = fld.ParseName("IDM SEMO.lnk")
>> "%SEMO_WORK%\semo_pin.vbs" echo   If Not itm Is Nothing Then
>> "%SEMO_WORK%\semo_pin.vbs" echo     For Each v In itm.Verbs
>> "%SEMO_WORK%\semo_pin.vbs" echo       If Not pinned And InStr(1, LCase(v.Name), "taskbar", 1) > 0 And InStr(1, LCase(v.Name), "unpin", 1) = 0 Then
>> "%SEMO_WORK%\semo_pin.vbs" echo         v.DoIt
>> "%SEMO_WORK%\semo_pin.vbs" echo         If Err.Number = 0 Then pinned = True
>> "%SEMO_WORK%\semo_pin.vbs" echo         Err.Clear
>> "%SEMO_WORK%\semo_pin.vbs" echo       End If
>> "%SEMO_WORK%\semo_pin.vbs" echo     Next
>> "%SEMO_WORK%\semo_pin.vbs" echo   End If
>> "%SEMO_WORK%\semo_pin.vbs" echo End If
>> "%SEMO_WORK%\semo_pin.vbs" echo If Not pinned Then
>> "%SEMO_WORK%\semo_pin.vbs" echo   ql = ws.ExpandEnvironmentStrings("%APPDATA%") ^& "\Microsoft\Internet Explorer\Quick Launch\User Pinned\TaskBar"
>> "%SEMO_WORK%\semo_pin.vbs" echo   If fso.FolderExists(ql) Then fso.CopyFile desk, ql ^& "\IDM SEMO.lnk", True
>> "%SEMO_WORK%\semo_pin.vbs" echo End If
cscript //nologo "%SEMO_WORK%\semo_pin.vbs" >nul 2>&1
exit /b 0

:write_dec
> "%SEMO_WORK%\semo_dec.ps1" echo param($in, $out, $mk)
>> "%SEMO_WORK%\semo_dec.ps1" echo $t = [IO.File]::ReadAllText($in, [Text.Encoding]::GetEncoding(28591))
>> "%SEMO_WORK%\semo_dec.ps1" echo $i = $t.IndexOf($mk, [StringComparison]::Ordinal)
>> "%SEMO_WORK%\semo_dec.ps1" echo if ($i -lt 0) { exit 3 }
>> "%SEMO_WORK%\semo_dec.ps1" echo $b64 = $t.Substring($i + $mk.Length) -replace '\s', ''
>> "%SEMO_WORK%\semo_dec.ps1" echo try { [IO.File]::WriteAllBytes($out, [Convert]::FromBase64String($b64)) } catch { exit 4 }
>> "%SEMO_WORK%\semo_dec.ps1" echo exit 0
> "%SEMO_WORK%\semo_dec.vbs" echo Option Explicit
>> "%SEMO_WORK%\semo_dec.vbs" echo Dim args, ad, s, i, b64, xml, node, out, chunk, CH, marker
>> "%SEMO_WORK%\semo_dec.vbs" echo On Error Resume Next
>> "%SEMO_WORK%\semo_dec.vbs" echo Set args = WScript.Arguments
>> "%SEMO_WORK%\semo_dec.vbs" echo If args.Count ^< 3 Then WScript.Quit 1
>> "%SEMO_WORK%\semo_dec.vbs" echo Set ad = CreateObject("ADODB.Stream")
>> "%SEMO_WORK%\semo_dec.vbs" echo ad.Type = 2
>> "%SEMO_WORK%\semo_dec.vbs" echo ad.CharSet = "iso-8859-1"
>> "%SEMO_WORK%\semo_dec.vbs" echo ad.Open
>> "%SEMO_WORK%\semo_dec.vbs" echo ad.LoadFromFile args(0)
>> "%SEMO_WORK%\semo_dec.vbs" echo s = ad.ReadText(-1)
>> "%SEMO_WORK%\semo_dec.vbs" echo ad.Close
>> "%SEMO_WORK%\semo_dec.vbs" echo If Err.Number ^<^> 0 Then WScript.Quit 2
>> "%SEMO_WORK%\semo_dec.vbs" echo marker = args(2)
>> "%SEMO_WORK%\semo_dec.vbs" echo i = InStr(1, s, marker, vbBinaryCompare)
>> "%SEMO_WORK%\semo_dec.vbs" echo If i ^<= 0 Then WScript.Quit 3
>> "%SEMO_WORK%\semo_dec.vbs" echo b64 = Mid(s, i + Len(marker))
>> "%SEMO_WORK%\semo_dec.vbs" echo b64 = Replace(b64, vbCr, "")
>> "%SEMO_WORK%\semo_dec.vbs" echo b64 = Replace(b64, vbLf, "")
>> "%SEMO_WORK%\semo_dec.vbs" echo Set xml = CreateObject("MSXML2.DOMDocument.6.0")
>> "%SEMO_WORK%\semo_dec.vbs" echo If Err.Number ^<^> 0 Then
>> "%SEMO_WORK%\semo_dec.vbs" echo   Err.Clear
>> "%SEMO_WORK%\semo_dec.vbs" echo   Set xml = CreateObject("MSXML2.DOMDocument.3.0")
>> "%SEMO_WORK%\semo_dec.vbs" echo End If
>> "%SEMO_WORK%\semo_dec.vbs" echo If Err.Number ^<^> 0 Then WScript.Quit 4
>> "%SEMO_WORK%\semo_dec.vbs" echo On Error GoTo 0
>> "%SEMO_WORK%\semo_dec.vbs" echo Set node = xml.createElement("b64")
>> "%SEMO_WORK%\semo_dec.vbs" echo node.dataType = "bin.base64"
>> "%SEMO_WORK%\semo_dec.vbs" echo Set out = CreateObject("ADODB.Stream")
>> "%SEMO_WORK%\semo_dec.vbs" echo out.Type = 1
>> "%SEMO_WORK%\semo_dec.vbs" echo out.Open
>> "%SEMO_WORK%\semo_dec.vbs" echo CH = 4000000
>> "%SEMO_WORK%\semo_dec.vbs" echo For i = 1 To Len(b64) Step CH
>> "%SEMO_WORK%\semo_dec.vbs" echo   chunk = Mid(b64, i, CH)
>> "%SEMO_WORK%\semo_dec.vbs" echo   node.Text = chunk
>> "%SEMO_WORK%\semo_dec.vbs" echo   out.Write node.nodeTypedValue
>> "%SEMO_WORK%\semo_dec.vbs" echo Next
>> "%SEMO_WORK%\semo_dec.vbs" echo out.SaveToFile args(1), 2
>> "%SEMO_WORK%\semo_dec.vbs" echo WScript.Quit 0
exit /b 0

:write_setupsrc
> "%SEMO_WORK%\setup_gui.cs" echo // BELGESELSEMO IDM SEMO - Windows Setup GUI (v9)
>> "%SEMO_WORK%\setup_gui.cs" echo // bat tarafindan derlenir: csc /codepage:65001 /t:winexe setup_gui.cs
>> "%SEMO_WORK%\setup_gui.cs" echo // args: ^<bat yolu^> ^<SEMO_INST^> ^<IS_ADMIN 0/1^> ^<csc yolu^>
>> "%SEMO_WORK%\setup_gui.cs" echo // cmd penceresi yok: tum kurulum ciktilari bu pencerede modern sekilde gosterilir,
>> "%SEMO_WORK%\setup_gui.cs" echo // sistem dili otomatik algilanir, kurulum surerken diger projeler kartlarda tanitilir,
>> "%SEMO_WORK%\setup_gui.cs" echo // bittiginde IDM SEMO paneli otomatik acilir.
>> "%SEMO_WORK%\setup_gui.cs" echo using System;
>> "%SEMO_WORK%\setup_gui.cs" echo using System.Collections;
>> "%SEMO_WORK%\setup_gui.cs" echo using System.Diagnostics;
>> "%SEMO_WORK%\setup_gui.cs" echo using System.Drawing;
>> "%SEMO_WORK%\setup_gui.cs" echo using System.Globalization;
>> "%SEMO_WORK%\setup_gui.cs" echo using System.IO;
>> "%SEMO_WORK%\setup_gui.cs" echo using System.Text;
>> "%SEMO_WORK%\setup_gui.cs" echo using System.Threading;
>> "%SEMO_WORK%\setup_gui.cs" echo using System.Windows.Forms;
>> "%SEMO_WORK%\setup_gui.cs" echo using System.Drawing.Drawing2D;
>> "%SEMO_WORK%\setup_gui.cs" echo.
>> "%SEMO_WORK%\setup_gui.cs" echo class SemSetup
>> "%SEMO_WORK%\setup_gui.cs" echo {
>> "%SEMO_WORK%\setup_gui.cs" echo     // ---------------- tema (panel Ui.cs birebir) ----------------
>> "%SEMO_WORK%\setup_gui.cs" echo     static Color BG_ROOT = H("#090e17"), BG_CARD = H("#131c31"), BG_CARD_ALT = H("#192540"),
>> "%SEMO_WORK%\setup_gui.cs" echo         BG_MAIN = H("#0b1120"), BORDER = H("#23324d"), FG = H("#f8fafc"), MUT = H("#94a3b8"),
>> "%SEMO_WORK%\setup_gui.cs" echo         DIM = H("#64748b"), CYAN = H("#0ea5e9"), GREEN = H("#10b981"), RED = H("#ef4444"),
>> "%SEMO_WORK%\setup_gui.cs" echo         CONSOLE = H("#050811"), INPUT = H("#090e17"), CREDIT_BG = H("#101b33"), CREDIT_BRD = H("#243b61");
>> "%SEMO_WORK%\setup_gui.cs" echo     static Color _stageColor = H("#0ea5e9");   // v17: gunluk durumu cizgisi (cyan/hata kirmizi/bitti yesil)
>> "%SEMO_WORK%\setup_gui.cs" echo.
>> "%SEMO_WORK%\setup_gui.cs" echo     static Color H(string x)
>> "%SEMO_WORK%\setup_gui.cs" echo     {
>> "%SEMO_WORK%\setup_gui.cs" echo         return Color.FromArgb(Convert.ToInt32(x.Substring(1, 2), 16), Convert.ToInt32(x.Substring(3, 2), 16), Convert.ToInt32(x.Substring(5, 2), 16));
>> "%SEMO_WORK%\setup_gui.cs" echo     }
>> "%SEMO_WORK%\setup_gui.cs" echo.
>> "%SEMO_WORK%\setup_gui.cs" echo     // ---------------- i18n ----------------
>> "%SEMO_WORK%\setup_gui.cs" echo     static string[] LANGS = new string[] { "tr", "en", "ar", "az", "de", "el", "fa", "fr", "hi", "id", "it", "ja", "ka", "ky", "nl", "pt", "ro", "ru", "vi", "zh" };
>> "%SEMO_WORK%\setup_gui.cs" echo     static string _lang = "en";
>> "%SEMO_WORK%\setup_gui.cs" echo     static Hashtable _t = new Hashtable();
>> "%SEMO_WORK%\setup_gui.cs" echo.
>> "%SEMO_WORK%\setup_gui.cs" echo     static string Tr(string k)
>> "%SEMO_WORK%\setup_gui.cs" echo     {
>> "%SEMO_WORK%\setup_gui.cs" echo         object v = _t[k];
>> "%SEMO_WORK%\setup_gui.cs" echo         return (v == null) ? k : (string)v;
>> "%SEMO_WORK%\setup_gui.cs" echo     }
>> "%SEMO_WORK%\setup_gui.cs" echo.
>> "%SEMO_WORK%\setup_gui.cs" echo     static string Tr2(string k, string arg)
>> "%SEMO_WORK%\setup_gui.cs" echo     {
>> "%SEMO_WORK%\setup_gui.cs" echo         return Tr(k).Replace("{0}", arg);
>> "%SEMO_WORK%\setup_gui.cs" echo     }
>> "%SEMO_WORK%\setup_gui.cs" echo.
>> "%SEMO_WORK%\setup_gui.cs" echo     static void LoadSetupStrings(string code)
>> "%SEMO_WORK%\setup_gui.cs" echo     {
>> "%SEMO_WORK%\setup_gui.cs" echo         for (int i = 0; i ^< LANGS.Length; i++)
>> "%SEMO_WORK%\setup_gui.cs" echo         {
>> "%SEMO_WORK%\setup_gui.cs" echo             if (LANGS[i] != code) continue;
>> "%SEMO_WORK%\setup_gui.cs" echo             Hashtable h = new Hashtable();
>> "%SEMO_WORK%\setup_gui.cs" echo             string[] rows = (SETUP_DICTS[i] + "\n" + PROJ_DICTS[i]).Split('\n');
>> "%SEMO_WORK%\setup_gui.cs" echo             for (int r = 0; r ^< rows.Length; r++)
>> "%SEMO_WORK%\setup_gui.cs" echo             {
>> "%SEMO_WORK%\setup_gui.cs" echo                 string line = rows[r].Trim();
>> "%SEMO_WORK%\setup_gui.cs" echo                 if (line.Length ^< 3) continue;
>> "%SEMO_WORK%\setup_gui.cs" echo                 int eq = line.IndexOf('=');
>> "%SEMO_WORK%\setup_gui.cs" echo                 if (eq ^< 1) continue;
>> "%SEMO_WORK%\setup_gui.cs" echo                 h[line.Substring(0, eq).Trim()] = line.Substring(eq + 1).Trim();
>> "%SEMO_WORK%\setup_gui.cs" echo             }
>> "%SEMO_WORK%\setup_gui.cs" echo             _t = h;
>> "%SEMO_WORK%\setup_gui.cs" echo             _lang = code;
>> "%SEMO_WORK%\setup_gui.cs" echo             return;
>> "%SEMO_WORK%\setup_gui.cs" echo         }
>> "%SEMO_WORK%\setup_gui.cs" echo         _lang = "en";
>> "%SEMO_WORK%\setup_gui.cs" echo     }
>> "%SEMO_WORK%\setup_gui.cs" echo.
>> "%SEMO_WORK%\setup_gui.cs" echo     static string DetectLang()
>> "%SEMO_WORK%\setup_gui.cs" echo     {
>> "%SEMO_WORK%\setup_gui.cs" echo         try
>> "%SEMO_WORK%\setup_gui.cs" echo         {
>> "%SEMO_WORK%\setup_gui.cs" echo             string n = CultureInfo.CurrentUICulture.Name;
>> "%SEMO_WORK%\setup_gui.cs" echo             if (n == null ^|^| n.Length ^< 2) return "en";
>> "%SEMO_WORK%\setup_gui.cs" echo             string p = n.Substring(0, 2).ToLowerInvariant();
>> "%SEMO_WORK%\setup_gui.cs" echo             for (int i = 0; i ^< LANGS.Length; i++) if (LANGS[i] == p) return p;
>> "%SEMO_WORK%\setup_gui.cs" echo             return "en";
>> "%SEMO_WORK%\setup_gui.cs" echo         }
>> "%SEMO_WORK%\setup_gui.cs" echo         catch { return "en"; }
>> "%SEMO_WORK%\setup_gui.cs" echo     }
>> "%SEMO_WORK%\setup_gui.cs" echo.
>> "%SEMO_WORK%\setup_gui.cs" echo     // 20 dilde kurulum metinleri (dil basina bir blok; satir: anahtar=deger)
>> "%SEMO_WORK%\setup_gui.cs" echo     static string[] SETUP_DICTS = new string[]
>> "%SEMO_WORK%\setup_gui.cs" echo     {
>> "%SEMO_WORK%\setup_gui.cs" echo         // tr
>> "%SEMO_WORK%\setup_gui.cs" echo         "setup.title=BELGESELSEMO IDM SEMO - Windows Kurulumu\n"
>> "%SEMO_WORK%\setup_gui.cs" echo         + "setup.sub=Tek dosya kurulumu - XP / Vista / 7 / 8 / 10 / 11 - 20 dil - Video - Torrent - eD2K\n"
>> "%SEMO_WORK%\setup_gui.cs" echo         + "setup.os=Isletim sistemi\n"
>> "%SEMO_WORK%\setup_gui.cs" echo         + "setup.target=Kurulum yeri\n"
>> "%SEMO_WORK%\setup_gui.cs" echo         + "setup.compiler=C# derleyici\n"
>> "%SEMO_WORK%\setup_gui.cs" echo         + "setup.stage1=Payload cozuluyor ({0} MB)...\n"
>> "%SEMO_WORK%\setup_gui.cs" echo         + "setup.stage1ok=Payload cozuldu ({0} bayt)\n"
>> "%SEMO_WORK%\setup_gui.cs" echo         + "setup.stage2=Dosyalar cikariliyor...\n"
>> "%SEMO_WORK%\setup_gui.cs" echo         + "setup.stage2ok={0} dosya cikarildi\n"
>> "%SEMO_WORK%\setup_gui.cs" echo         + "setup.stage3=Arayuz dili algilaniyor...\n"
>> "%SEMO_WORK%\setup_gui.cs" echo         + "setup.stage3ok=Arayuz dili: {0}\n"
>> "%SEMO_WORK%\setup_gui.cs" echo         + "setup.stage4=IDM SEMO paneli derleniyor...\n"
>> "%SEMO_WORK%\setup_gui.cs" echo         + "setup.stage4ok=IDM-SEMO.exe hazir\n"
