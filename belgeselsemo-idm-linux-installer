#!/bin/sh
# ============================================================
#  IDM LINUX — belgeselsemo-idm-linux-installer
#  Tek satırda otomatik kurulum (BELGESELSEMO)
#
#  Kullanım / Usage:
#    curl -fsSL https://raw.githubusercontent.com/vesvese55x/IDM-LINUX/refs/heads/main/belgeselsemo-idm-linux-installer | sh
#
#  Ne yapar? / What it does:
#    1) Linux dağıtımınızı algılar (Debian/Ubuntu/Mint, Fedora/openSUSE/RHEL,
#       Arch/Manjaro/Cachy OS ve türevleri) — detects your distribution
#    2) GitHub Releases'ten daima EN GÜNCEL paketi indirir
#       — always downloads the LATEST package from GitHub Releases
#    3) Sisteminize uygun komutla kurar — installs it the right way
#
#  Test modu / Dry run:  IDM_INSTALLER_DRY_RUN=1 sh belgeselsemo-idm-linux-installer
#  ============================================================
set -u

REPO="vesvese55x/IDM-LINUX"
BASE="https://github.com/${REPO}/releases/latest/download"
OS_RELEASE_FILE="${IDM_INSTALLER_OS_RELEASE:-/etc/os-release}"
MIN_BYTES=500000

# ---------- çıktı / output ----------
if [ -t 1 ]; then
  C_G='\033[1;32m'; C_Y='\033[1;33m'; C_R='\033[1;31m'; C_C='\033[1;36m'; C_B='\033[1m'; C_0='\033[0m'
else
  C_G=''; C_Y=''; C_R=''; C_C=''; C_B=''; C_0=''
fi

# ---------- dil / language (tr | en) ----------
L=en
case "${LANG:-}" in tr*|TR*) L=tr ;; esac

if [ "$L" = tr ]; then
  M_TITLE="IDM LINUX otomatik kurucu — BELGESELSEMO"
  M_ARCH_OK="Mimari: x86_64 — uyumlu"
  M_ARCH_BAD="Desteklenmeyen mimari: %s. Yalnızca x86_64 desteklenir."
  M_FETCHER="İndirme aracı: %s"
  M_NO_FETCHER="Ne curl ne wget bulundu. Lütfen önce 'curl' veya 'wget' kurun."
  M_SUDO="Root yetkisi gerekiyor: sudo ile çalıştırılacak"
  M_ROOT="Root olarak çalışıyor"
  M_NO_SUDO="Root değilsiniz ve sistemde sudo yok. Betiği root olarak çalıştırın."
  M_DETECT="Dağıtım algılanıyor..."
  M_FOUND="Dağıtım: %s (ID=%s, ID_LIKE=%s)"
  M_UNKNOWN="Dağıtım tanınamadı — AppImage ile devam ediliyor (kurulumsuz çalışır)"
  M_PLAN="Kurulum planı"
  M_KIND="Paket türü: %s"
  M_ASSET="Paket: %s"
  M_URL="Kaynak (daima en güncel release): %s"
  M_DRY="DRY RUN — indirme ve kurulum atlandı (gerçek kurulum için bu değişken olmadan çalıştırın)"
  M_DL="En güncel paket indiriliyor..."
  M_DL_OK="İndirildi: %s (%s KB)"
  M_DL_FAIL="Paket indirilemedi. İnternet bağlantınızı kontrol edin ve tekrar deneyin."
  M_DL_BAD="İndirilen dosya beklenen boyutta değil — indirme bozuk görünüyor."
  M_INSTALL="%s paketi kuruluyor..."
  M_DONE="Kurulum tamamlandı!"
  M_DONE_AI="AppImage şuraya kuruldu: %s"
  M_RUN="Uygulama menüsünden 'IDM LINUX' ile ya da yukarıdaki komutlarla başlatabilirsiniz."
  M_CLEAN="Geçici dosyalar temizlendi."
else
  M_TITLE="IDM LINUX auto installer — BELGESELSEMO"
  M_ARCH_OK="Architecture: x86_64 — supported"
  M_ARCH_BAD="Unsupported architecture: %s. Only x86_64 is supported."
  M_FETCHER="Download tool: %s"
  M_NO_FETCHER="Neither curl nor wget was found. Please install 'curl' or 'wget' first."
  M_SUDO="Root privileges required: will run through sudo"
  M_ROOT="Running as root"
  M_NO_SUDO="You are not root and sudo is missing. Run this script as root."
  M_DETECT="Detecting distribution..."
  M_FOUND="Distribution: %s (ID=%s, ID_LIKE=%s)"
  M_UNKNOWN="Distribution not recognized — falling back to AppImage (runs without install)"
  M_PLAN="Install plan"
  M_KIND="Package type: %s"
  M_ASSET="Package: %s"
  M_URL="Source (always the latest release): %s"
  M_DRY="DRY RUN — download and install skipped (run without this variable to install for real)"
  M_DL="Downloading the latest package..."
  M_DL_OK="Downloaded: %s (%s KB)"
  M_DL_FAIL="Could not download the package. Check your internet connection and try again."
  M_DL_BAD="The downloaded file has an unexpected size — the download looks corrupted."
  M_INSTALL="Installing the %s package..."
  M_DONE="Installation complete!"
  M_DONE_AI="AppImage installed to: %s"
  M_RUN="You can start it from the app menu as 'IDM LINUX' or with the commands above."
  M_CLEAN="Temporary files cleaned up."
fi

say()  { printf "%b\n" "${C_C}::${C_0} $1"; }
ok()   { printf "%b\n" "${C_G} \342\234\224 ${C_0}$1"; }
warn() { printf "%b\n" "${C_Y} ! ${C_0}$1"; }
die()  { printf "%b\n" "${C_R} \342\234\226 ${C_0}$1" >&2; exit 1; }

printf "%b\n" "${C_B}${M_TITLE}${C_0}"
printf "%b\n" "------------------------------------------------------------"

# ---------- 1) mimari / architecture ----------
ARCH="$(uname -m 2>/dev/null || echo unknown)"
[ "$ARCH" = "x86_64" ] || die "$(printf "$M_ARCH_BAD" "$ARCH")"
ok "$M_ARCH_OK"

# ---------- 2) indirme aracı / download tool ----------
FETCHER=""
if command -v curl >/dev/null 2>&1; then
  FETCHER="curl"
elif command -v wget >/dev/null 2>&1; then
  FETCHER="wget"
else
  die "$M_NO_FETCHER"
fi
ok "$(printf "$M_FETCHER" "$FETCHER")"

# ---------- 3) yetki / privileges ----------
SUDO=""
if [ "$(id -u)" -eq 0 ]; then
  ok "$M_ROOT"
else
  command -v sudo >/dev/null 2>&1 || die "$M_NO_SUDO"
  SUDO="sudo"
  ok "$M_SUDO"
fi

# ---------- 4) dağıtım algılama / distribution detection ----------
say "$M_DETECT"
DIST_ID=""; DIST_LIKE=""; PRETTY="?"
if [ -r "$OS_RELEASE_FILE" ]; then
  # shellcheck disable=SC1090
  . "$OS_RELEASE_FILE"
  DIST_ID="${ID:-}"
  DIST_LIKE="${ID_LIKE:-}"
  PRETTY="${PRETTY_NAME:-$DIST_ID}"
fi
ok "$(printf "$M_FOUND" "$PRETTY" "${DIST_ID:-?}" "${DIST_LIKE:--}")"

PKG_KIND=""
case "$DIST_ID" in
  debian|ubuntu|linuxmint|pop|mx|elementary|zorin|neon|deepin|kali|parrot|antix|devuan|trisquel|peppermint|lmde) PKG_KIND="deb" ;;
  fedora|rhel|centos|rocky|almalinux|ol|oracle|amzn|nobara|ultramarine|rocknix|clear-linux-os) PKG_KIND="rpm" ;;
  opensuse*|suse|sles|sled) PKG_KIND="rpm" ;;
  arch|manjaro|cachyos|endeavouros|garuda|artix|arcolinux|bluestar|rebornos|archcraft|kaos) PKG_KIND="zst" ;;
esac
if [ -z "$PKG_KIND" ] && [ -n "$DIST_LIKE" ]; then
  case "$DIST_LIKE" in
    *debian*) PKG_KIND="deb" ;;
    *fedora*|*rhel*|*suse*|*sles*) PKG_KIND="rpm" ;;
    *arch*) PKG_KIND="zst" ;;
  esac
fi
if [ -z "$PKG_KIND" ]; then
  PKG_KIND="appimage"
  warn "$M_UNKNOWN"
fi

case "$PKG_KIND" in
  deb)      ASSET="idm-linux_1.0.0_all.deb"            ; KIND_NAME="deb" ;;
  rpm)      ASSET="idm-linux-1.0.0-1.noarch.rpm"       ; KIND_NAME="rpm" ;;
  zst)      ASSET="idm-linux-1.0.0-1-any.pkg.tar.zst"  ; KIND_NAME="zst" ;;
  appimage) ASSET="IDM-LINUX-1.0.0-x86_64.AppImage"    ; KIND_NAME="AppImage" ;;
esac
URL="${BASE}/${ASSET}"

# ---------- 5) plan / plan ----------
say "$M_PLAN"
ok "$(printf "$M_KIND" "$KIND_NAME")"
ok "$(printf "$M_ASSET" "$ASSET")"
ok "$(printf "$M_URL" "$URL")"

if [ "${IDM_INSTALLER_DRY_RUN:-0}" = "1" ]; then
  warn "$M_DRY"
  exit 0
fi

# ---------- 6) indir / download ----------
TMPDIR_DL="$(mktemp -d 2>/dev/null || mktemp -d -t idmXXXXXX)" || die "mktemp failed"
FILE="${TMPDIR_DL}/${ASSET}"
say "$M_DL"
if [ "$FETCHER" = "curl" ]; then
  curl -fsSL -o "$FILE" "$URL" || { rm -rf "$TMPDIR_DL"; die "$M_DL_FAIL"; }
else
  wget -qO "$FILE" "$URL" || { rm -rf "$TMPDIR_DL"; die "$M_DL_FAIL"; }
fi
SIZE="$(wc -c < "$FILE" 2>/dev/null || echo 0)"
[ "$SIZE" -ge "$MIN_BYTES" ] || { rm -rf "$TMPDIR_DL"; die "$M_DL_BAD"; }
ok "$(printf "$M_DL_OK" "$FILE" "$((SIZE / 1024))")"

# ---------- 7) kur / install ----------
say "$(printf "$M_INSTALL" "$KIND_NAME")"
case "$PKG_KIND" in
  deb)
    $SUDO apt-get install -y "$FILE" 2>/dev/null \
      || $SUDO apt-get install -y -f "$FILE" 2>/dev/null \
      || $SUDO dpkg -i "$FILE" \
      || { rm -rf "$TMPDIR_DL"; die "$M_DL_FAIL"; }
    ;;
  rpm)
    if command -v dnf >/dev/null 2>&1; then
      $SUDO dnf install -y "$FILE" || { rm -rf "$TMPDIR_DL"; die "$M_DL_FAIL"; }
    elif command -v yum >/dev/null 2>&1; then
      $SUDO yum install -y "$FILE" || { rm -rf "$TMPDIR_DL"; die "$M_DL_FAIL"; }
    elif command -v zypper >/dev/null 2>&1; then
      $SUDO zypper --no-gpg-checks install -y "$FILE" || { rm -rf "$TMPDIR_DL"; die "$M_DL_FAIL"; }
    else
      $SUDO rpm -Uvh --force "$FILE" || { rm -rf "$TMPDIR_DL"; die "$M_DL_FAIL"; }
    fi
    ;;
  zst)
    $SUDO pacman -U --noconfirm --needed "$FILE" || { rm -rf "$TMPDIR_DL"; die "$M_DL_FAIL"; }
    ;;
  appimage)
    DEST_DIR="${HOME}/.local/bin"
    mkdir -p "$DEST_DIR"
    DEST_FILE="${DEST_DIR}/IDM-LINUX-1.0.0-x86_64.AppImage"
    cp -f "$FILE" "$DEST_FILE" && chmod 755 "$DEST_FILE" || { rm -rf "$TMPDIR_DL"; die "$M_DL_FAIL"; }
    ;;
esac

# ---------- 8) temizlik + son / cleanup + final ----------
rm -rf "$TMPDIR_DL"
ok "$M_CLEAN"
printf "%b\n" "------------------------------------------------------------"
if [ "$PKG_KIND" = "appimage" ]; then
  ok "$(printf "$M_DONE_AI" "$DEST_FILE")"
else
  ok "$M_DONE"
fi
ok "$M_RUN"
printf "%b\n" "${C_G}${M_DONE}${C_0}"
